# ==============================================================================
# StationPro — Variables d'environnement (Frontend Vite & Base PostgreSQL/Prisma)
# Copiez ce fichier en `.env` pour le développement local ou configurez votre CI/CD.
# Ne commitez jamais de vrais secrets dans Git.
# ==============================================================================

# --- API Backend & Supabase (Client Vite) ---
# Laissez VITE_API_BASE_URL vide pour exécuter l'application en mode bac à sable local.
VITE_API_BASE_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Code d'accès Super Administrateur utilisé par AdminAuthGuard en pré-production locale.
# En production, remplacez par une authentification OIDC/JWT serveur dédiée.
VITE_ADMIN_ACCESS_CODE=202699

# --- Base de Données PostgreSQL / Supabase (Prisma & Migrations SQL) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stationpro?schema=public&pgbouncer=true"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/stationpro?schema=public"
